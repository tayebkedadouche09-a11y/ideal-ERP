{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci --prefix frontend",
  "buildCommand": "npm run build --prefix frontend",
  "outputDirectory": "frontend/dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "destination": "/core/home",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/login",
      "destination": "/api/login"
    },
    {
      "source": "/login/:path*",
      "destination": "/api/login/:path*"
    },
    {
      "source": "/app",
      "destination": "/api/app"
    },
    {
      "source": "/app/:path*",
      "destination": "/api/app/:path*"
    },
    {
      "source": "/core",
      "destination": "/index.html"
    },
    {
      "source": "/core/:path*",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/[...path].js": {
      "runtime": "nodejs20.x",
      "maxDuration": 60
    }
  }
}
